.venv/
__pycache__/
*.pyc
# raw datasets (licensed; re-download with data/download_datasets.py)
data/raw/
# large processed stores (rebuildable)
data/processed/ait/*.sqlite
data/processed/cert/*.sqlite
data/processed/cert/evidence_store.json
data/processed/ait/evidence_store.json
# live testbed state (contains testbed-only credentials and hidden systems of record)
testbed/state/
# bulky episode-level outputs and traces (rebuildable; hashes in results/EXPERIMENT_MANIFEST.json)
results/raw/
results/traces/
data/processed/cert_stage2/*.sqlite
data/processed/cert_stage2/evidence_store.json
data/processed/ait_stage2/evidence_store.json
results/stage1_ungated/raw/
results/stage1_ungated/traces/
results/stage2/raw/
results/stage2/traces/
results/stage2/adequacy/*.csv.gz
